<%= form_with(model: post, local: true) do |f| %>
  <% if post.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading"><%= pluralize(post.errors.count, "error") %> prevented this tweet from being saved:</h4>
      <ul class="mb-0">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :content, "What's happening?", class: 'form-label' %>
    <%= f.text_area :content, rows: 5, class: 'form-control' %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit "Post Tweet", class: "btn btn-primary" %>
    <%= link_to 'Back', posts_path, class: 'btn btn-secondary' %>
  </div>
<% end %>