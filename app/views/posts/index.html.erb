<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">Feed</h2>
  <div>
    <%= link_to 'Compose New Tweet', new_post_path, class: 'btn btn-success btn-sm me-2' %>
    <%= link_to 'All Tweets', posts_path, class: 'btn btn-outline-secondary btn-sm' %>
  </div>
</div>

<div class="row">
  <% @posts.each do |post| %>
    <div class="col-12">
      <div class="card mb-3">
        <div class="card-body">
          <p class="card-text"><%= simple_format(post.content) %></p>
          <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted"><%= post.created_at.strftime("%Y-%m-%d %H:%M") %></small>
            <div class="btn-group" role="group" aria-label="Post actions">
              <%= link_to 'Edit', edit_post_path(post), class: 'btn btn-outline-secondary btn-sm' %>
              <%= button_to 'Delete', post_path(post), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm', form: { class: 'd-inline' } %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>